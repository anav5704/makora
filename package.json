{
    "name": "makora",
    "private": true,
    "type": "module",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "check": "biome check",
        "fix": "biome check --write",
        "dev": "pnpm -r dev",
        "build": "pnpm -r build",
        "dev:web": "pnpm --filter web dev",
        "dev:api": "pnpm --filter api dev",
        "dev:worker": "pnpm --filter worker dev",
        "dev:sync": "pnpm --filter worker dev:sync",
        "dev:analysis": "pnpm --filter worker dev:analysis",
        "db:push": "pnpm --filter @makora/db db:push",
        "db:studio": "pnpm --filter @makora/db db:studio",
        "db:generate": "pnpm --filter @makora/db db:generate",
        "compose:up": "docker compose up -d",
        "compose:down": "docker compose down"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@types/node": "^22.20.5",
        "tsdown": "^0.15.12"
    },
    "packageManager": "pnpm@10.23.0"
}
